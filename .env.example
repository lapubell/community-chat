# Copy this file to `.env` and adjust values. docker compose reads `.env`.

# Port the app listens on (host and container). Default 8983.
PORT=8983

# JWT signing key. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Seeded admin account, created on first boot only.
ADMIN_HANDLE=admin
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Web Push (VAPID) — push notifications. Generate a keypair (see README) and
# put the PRIVATE key here; the PUBLIC key is used by the frontend. Optional:
# without these, push notifications are disabled (the app still works).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@example.com
