# Copy this file to `.env` and adjust values. docker compose reads `.env`.

# Port the app listens on (host and container). Default 8983.
PORT=8983

# JWT signing key. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Seeded admin account, created on first boot only.
ADMIN_HANDLE=admin
ADMIN_PASSWORD=
ADMIN_NAME=Admin
